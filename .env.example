# Copy this file to .env and fill in your values.
# .env is gitignored and should never be committed.

# Database URL (SQLite default — works out of the box for local development)
# SANCTUM_DATABASE_URL=sqlite:///./sanctum.db

# Postgres (required for production/deployment on Render, Railway, etc.)
# Get this from Neon / Supabase / Railway dashboard.
SANCTUM_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
